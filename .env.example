# Azure app registration "Application (client) ID" (Personal Microsoft accounts only, Mobile & desktop, redirect http://localhost).
HALO_AZURE_CLIENT_ID=

# Testing shortcut only: a Spartan token copied from browser DevTools (x-343-authorization-spartan header).
# Short-lived (~4h) and bound to YOUR account. Never share or commit it. When set, MSAL is skipped.
HALO_SPARTAN_TOKEN=
