{
  // Hosted copy: static sample dashboard (.preview/) plus live player lookup through a dedicated Xbox account.
  // `npm run deploy` rebuilds .preview/ first. Lookup needs these secrets (README → "Hosted lookup"), set with
  // `wrangler secret put`, never in this file: HALO_AZURE_CLIENT_ID, HALO_REFRESH_TOKEN_SEED, IP_SALT,
  // and optionally TURNSTILE_SECRET + TURNSTILE_SITE_KEY.
  "name": "halo-ranked-tracker",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "assets": {
    "directory": "./.preview",
    "binding": "ASSETS",
    // Only these reach the Worker; /api/ranks keeps being served by the static _redirects rule.
    "run_worker_first": ["/api/player", "/api/avatar/*", "/api/config"]
  },
  "durable_objects": { "bindings": [{ "name": "VAULT", "class_name": "HaloVault" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HaloVault"] }],
  // Per visitor and per Cloudflare location; the global budgets live in the vault (see LIMIT_* below).
  "ratelimits": [
    { "name": "RL_BURST", "namespace_id": "4101", "simple": { "limit": 6, "period": 10 } },
    { "name": "RL_MINUTE", "namespace_id": "4102", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    "LOOKUP_ENABLED": "true", // set to "false" and redeploy to switch lookups off
    "LIMIT_UNCACHED_PER_MINUTE": "6",
    "LIMIT_UNCACHED_PER_HOUR": "60",
    "LIMIT_UNCACHED_PER_DAY": "300",
    "LIMIT_UNCACHED_PER_IP_PER_HOUR": "10",
    "LIMIT_UPSTREAM_PER_MINUTE": "60"
  },
  "observability": { "enabled": true }
}
